{
	"hideChest" : {
		// item id of the armor, and a bool for whether it should hide extra animation parts on the chest when worn (like breasts)
		// all chest slot items implicitly hide the chest, and need to explicitly be set to false here
		// any other armor slot items do not implicitly hide the chest, but if they do, they should be set to true here
		"sbq_nude_chest" : false
	},
	"hideCrotch" : {
		// item id of the armor, and a bool for whether it should hide extra animation parts on the legs when worn (like cocks)
		// all legs slot items implicitly hide the crotch, and need to explicitly be set to false here
		// any other armor slot items do not implicitly hide the crotch, but if they do, they should be set to true here
		"sbq_nude_legs" : false
	}
}
